{
  "name": "code-audit",
  "packageManager": "yarn@4.12.0",
  "version": "1.0.0",
  "type": "module",
  "private": true,
  "bin": "./dist/bin/cli.js",
  "scripts": {
    "dev": "yarn build && node dist/bin/cli.js",
    "clean": "rm -rf dist",
    "build:dashboard": "cd dashboard && yarn install && yarn build",
    "build": "yarn build:dashboard && yarn tsup",
    "postinstall": "yarn build"
  },
  "dependencies": {
    "execa": "9.6.1",
    "jscpd": "4.0.8",
    "knip": "5.87.0",
    "madge": "8.0.0",
    "open": "11.0.0",
    "sirv": "3.0.2",
    "tsup": "8.5.1",
    "uuid": "13.0.0"
  },
  "devDependencies": {
    "@react-native/eslint-config": "^0.84.1",
    "@types/node": "^25.3.3",
    "eslint": "^8",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "prettier": "^3.8.1",
    "typescript": "5.9.3"
  }
}
